{
  "name": "esn-competition",
  "private": true,
  "version": "1.0.0",
  "description": "ESN Compétition — l’application compétition des nageurs de l’Ecole Seraing Natation (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "roster": "node scripts/roster.mjs",
    "audit": "vitest run --config vitest.audit.config.ts && node scripts/audit/show.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "web-push": "^3.6.7"
  }
}
