{
  "name": "nageo",
  "private": true,
  "version": "1.0.0",
  "description": "Nageo — le carnet de performances des parents de nageurs (PWA)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "club-index": "vite build --ssr scripts/club-index.ts --outDir node_modules/.cache/club-index --emptyOutDir --logLevel warn && node node_modules/.cache/club-index/club-index.js"
  },
  "dependencies": {
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "5.9",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
